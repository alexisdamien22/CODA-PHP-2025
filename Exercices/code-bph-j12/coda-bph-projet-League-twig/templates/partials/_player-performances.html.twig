<section id="player-performances">

    <h1>Ses performances</h1>

    <table class="">
        <thead>
            <tr>
                <th>TEAM ADVERSE</th>
                <th>POINTS</th>
                <th>ASSISTS</th>
                <th>VICTOIRE ?</th>
            </tr>
        </thead>
        <tbody>
            {% for i, performance in data.performances.perfs %}
                <tr>
                    {% if data.performances.team_1.i.getId() == data.player.getIdTeam() %}
                        <td class="enemy_team">{{ data.performances.team_2.i.getName() }}</td>
                    {% endif %}
                    {% if data.performances.team_2.i.getId() == data.player.getIdTeam() %}
                        <td class="enemy_team">{{ data.performances.team_1.i.getName() }}</td>
                    {% endif %}
                    <td>{{ performance.getPoints() }}</td>
                    <td>{{ performance.getAssists() }}</td>
                    {% if data.player.getIdTeam() == data.performances.winner.i.getId() %}
                        <td class="player-performances-yes">Oui</td>
                    {% endif %}
                    {% if data.player.getIdTeam() != data.performances.winner.i.getId() %}
                        <td class="player-performances-no">Non</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</section>